<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<% if current_user %>
  <p>Signed in as <%= current_user.name %></p>
  <%= button_to "Log out", logout_path, method: :delete %>
<% end %>

<ul>
  <% @todos.each do |todo| %>
    <li>
      <%= link_to todo.title, todo_path(todo) %>
      <br>
      <%= todo.description %>
    </li>
  <% end %>
</ul>

<%= link_to "Add Todo", new_todo_path %>