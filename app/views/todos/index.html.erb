<div class="toolbar">
  <h1>Your Todos</h1>
  <% if current_user %>
    <div>
      <p style="margin: 0 0 6px;">Signed in as <strong><%= current_user.name %></strong></p>
      <%= button_to "Log out", logout_path, method: :delete, class: "btn" %>
    </div>
  <% end %>
</div>

<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p class="alert"><%= flash[:alert] %></p>
<% end %>

<ul class="todo-list">
  <% @todos.each do |todo| %>
    <li class="todo-item">
      <strong><%= link_to todo.title, todo_path(todo) %></strong>
      <p><%= todo.description %></p>
    </li>
  <% end %>
</ul>

<%= link_to "Add Todo", new_todo_path, class: "btn" %>