<h1>Create New Todo</h1>

<%= form_with url: todos_path, method: :post do |form| %>
  <div>
    <%= form.label :title, "Todo title" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <%= form.submit "Save Todo" %>
<% end %>

<%= link_to "Back to todos", todos_path, class: "btn" %>